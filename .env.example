# Copy to .env and fill in. All values are public/publishable — never put a
# secret or service-role key in a VITE_* variable; it is inlined into the bundle.
# See docs/environment.md for what each one controls.

VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"
